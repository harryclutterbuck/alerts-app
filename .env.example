# Copy these into your host's "environment variables" screen. Never commit real values.

# --- required ---
MARGIN_SECRET=                      # 40+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
MARGIN_BASE_URL=https://alerts.yourdomain.com     # the public https address of this app (email links are built from it)
MARGIN_OPERATOR=Your Name or Organisation          # shown in the privacy page and email footers
MARGIN_CONTACT_EMAIL=hello@yourdomain.com          # also sent to OpenAlex and NCBI so they can reach you
MARGIN_BRAND=Margin                              # the product name subscribers see: pages, emails, privacy notice. Change this one value to rename.
MARGIN_FROM=Margin <alerts@yourdomain.com>   # display name here should match MARGIN_BRAND
SMTP_HOST=smtp.resend.com           # from your email provider
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=

# --- recommended ---
OPENALEX_API_KEY=                   # free, from openalex.org/settings/api (verify your email there first)
NCBI_API_KEY=                       # optional, from your NCBI account; raises PubMed's request limit

# --- optional (defaults shown) ---
# MARGIN_DIGEST_HOUR=7              # daily/weekly digests leave at or after this hour, UTC
# MARGIN_DIGEST_WEEKDAY=0           # weekly digests: 0 = Monday
# MARGIN_INGEST_HOURS=6             # how often new papers are pulled in
# MARGIN_INGEST_DAYS=              # leave unset: each source uses its own look-back (PubMed 1, arXiv 2, OpenAlex 3)
# MARGIN_PAPER_RETENTION_DAYS=35
# OPENALEX_MAX_PAGES=300            # safety cap per pull (1 credit and 200 papers per page)
# ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG,cs.CV,stat.ML,q-bio.GN,quant-ph
# Copy these into your host's "environment variables" screen. Never commit real values.

# --- required ---
MARGIN_SECRET=                      # 40+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
MARGIN_BASE_URL=https://alerts.yourdomain.com     # the public https address of this app (email links are built from it)
MARGIN_OPERATOR=Your Name or Organisation          # shown in the privacy page and email footers
MARGIN_CONTACT_EMAIL=hello@yourdomain.com          # also sent to OpenAlex and NCBI so they can reach you
MARGIN_PROVIDERS=Render (hosting, Frankfurt, Germany) and Resend (email delivery)   # privacy page: who hosts the data and sends the email; check where each processes data
MARGIN_BRAND=Margin                              # the product name subscribers see: pages, emails, privacy notice. Change this one value to rename.
MARGIN_HEADER=                                    # optional: shorter text for the logo at the top of each page, e.g. "The Margin". Blank = use MARGIN_BRAND.
MARGIN_FROM=Margin <alerts@yourdomain.com>   # display name here should match MARGIN_BRAND
SMTP_HOST=smtp.resend.com           # from your email provider
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=

# --- recommended ---
OPENALEX_API_KEY=                   # free, from openalex.org/settings/api (verify your email there first)
NCBI_API_KEY=                       # optional, from your NCBI account; raises PubMed's request limit

# --- optional (defaults shown) ---
# MARGIN_DIGEST_HOUR=7              # daily/weekly digests leave at or after this hour, UTC
# MARGIN_DIGEST_WEEKDAY=0           # weekly digests: 0 = Monday
# MARGIN_INGEST_HOURS=6             # how often new papers are pulled in
# MARGIN_INGEST_DAYS=              # leave unset: each source uses its own look-back (PubMed 1, arXiv 2, OpenAlex 7)
# MARGIN_PAPER_RETENTION_DAYS=35
# OPENALEX_MAX_PAGES=500            # safety cap per pull (1 credit and 200 papers per page)
# ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG,cs.CV,stat.ML,q-bio.GN,quant-ph
